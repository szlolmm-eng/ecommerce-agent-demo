# Optional: without this key the app safely uses Mock AI Provider.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Vercel Blob uses short-lived OIDC credentials automatically in Vercel.
# No long-lived Blob token is required or stored here.

# Optional local repository selection override. Vercel automatically selects Blob in production.
# PRODUCT_REPOSITORY=blob
